<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Phase 22: Android 13+ (API 33) requires this for the runtime push-notification prompt
         and to display FCM banners; harmless on older APIs. App still builds/runs without push. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Phase 29 (F1): re-register device-local CRM reminder notifications after
         a device reboot (flutter_local_notifications ScheduledNotificationBootReceiver). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Spec 005 D-01 — supabase_flutter (via its bundled app_links
                 plugin) owns the auth-callback deep link: it reads the ACTION_VIEW
                 intent itself and calls getSessionFromUrl().  Flutter's built-in
                 deep-linking (ON by default since Flutter 3.24) would ALSO feed the
                 incoming URI to the router as the initial route — which for
                 `alnujom://auth/reset-password#access_token=…` resolves to the
                 EXISTING `/reset-password` request-a-reset page, dropping the user
                 on the wrong screen.  Disable it: the intent still reaches the
                 activity (and therefore app_links); only the router hand-off is
                 suppressed.

                 Review §1 M3 — there IS now a second deep link (a shared
                 listing, below), and it does not change this.  It is read the
                 same way, off app_links, by `DeepLinkListener`, whose
                 `resolveDeepLink` returns null for `alnujom://auth/...` so the
                 two never both act on one URI. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Spec 005 D-01 — password-reset completion deep link.
                 Supabase's recovery mail redirects the browser to
                 `alnujom://auth/reset-password#access_token=…&type=recovery`
                 (or `…#error_description=…` for an expired link).  Both `path`
                 and `pathPrefix` are declared so the URI still matches when a
                 trailing slash / extra segment is appended; Android ignores the
                 query + fragment when matching, so they survive intact in
                 `Intent.getDataString()`.
                 The activity's `launchMode="singleTop"` (above) makes a RUNNING
                 app receive this through onNewIntent instead of a second task. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="alnujom"
                    android:host="auth"
                    android:path="/reset-password"/>
                <data
                    android:scheme="alnujom"
                    android:host="auth"
                    android:pathPrefix="/reset-password"/>
            </intent-filter>
            <!-- Review §1 M3 — a shared listing link.
                 `alnujom://listings/<uuid>` is what the web landing page's
                 "Open in app" button fires, and it is the ONLY form that works
                 today: a private scheme needs no domain and no verification.

                 An `https` filter is deliberately NOT here yet.  Without
                 `autoVerify` + a matching `/.well-known/assetlinks.json` at the
                 host ROOT, Android shows a chooser instead of opening the app —
                 and a GitHub *project* Pages site cannot serve that file at the
                 root.  It lands with the real domain (plan B16), together with
                 `android:autoVerify="true"`.

                 Read by `DeepLinkListener`, not by Flutter's router hand-off
                 (see `flutter_deeplinking_enabled` above). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="alnujom"
                    android:host="listings"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Phase 22: FCM default notification channel for Android 8.0+.
             Required by firebase_messaging for background messages.
             The app builds and runs without google-services.json (SC-003).

             The channel itself is created at startup with IMPORTANCE_HIGH by
             lib/core/notifications/push_notification_channel.dart — this value
             MUST stay byte-identical to PushNotificationChannel.channelId.
             The `_v2` suffix is load-bearing: a channel's importance is
             immutable once created, so the silent original id
             (`alnujom_notifications`) can only be superseded, never upgraded. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="alnujom_notifications_v2" />
        <!-- The status-bar icon. Without this meta-data FCM falls back to
             android:icon (@mipmap/launcher_icon), and since Android 5.0 the
             system keeps only a small icon's ALPHA and paints every opaque
             pixel white. launcher_icon is 100% opaque, so every push landed as
             a solid white square. @drawable/ic_notification is the flat white
             silhouette that shape actually requires. Keep it alpha-only — a
             coloured or fully-opaque replacement brings the white square back. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
        <!-- Phase 29 (F1): flutter_local_notifications receivers for scheduled
             (zonedSchedule) CRM follow-up reminders + reboot re-registration. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false" />
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
