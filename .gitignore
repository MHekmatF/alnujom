# =============================================================================
# AlNujom Real Estate — .gitignore
# Flutter (Android) + Supabase, Windows dev environment
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets & environment (NEVER commit)
# -----------------------------------------------------------------------------
.env
.env.json
.env.*
!.env.example
# Phase 24 (CR/T006) — the committed dart-define TEMPLATE (placeholder values
# only; NEVER a real DSN/secret). The real `.env.json` stays gitignored above.
!.env.example.json
*.env
secrets/
*.pem
*.key
*.p12
*.jks
*.keystore
key.properties
android/key.properties
android/app/upload-keystore.jks
android/app/release-keystore.jks
google-services.json
GoogleService-Info.plist
firebase_options.dart
service-account*.json

# Supabase local credentials & generated artifacts
supabase/.env
supabase/.env.*
supabase/.temp/
supabase/.branches/
supabase/logs/

# -----------------------------------------------------------------------------
# Flutter / Dart
# -----------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
.fvm/
.fvmrc
pubspec.lock.bak

# Coverage
coverage/
lcov.info
*.lcov

# Flutter symbolication
app.*.symbols
app.*.map.json

# -----------------------------------------------------------------------------
# Generated code (codegen — regenerate via build_runner / flutter gen-l10n)
# -----------------------------------------------------------------------------
# Injectable / json_serializable / freezed / etc.
*.g.dart
*.freezed.dart
*.gr.dart
*.mocks.dart
*.gen.dart

# Generated localization (flutter gen-l10n)
# Regenerated automatically by `flutter pub get` because pubspec sets
# `flutter.generate: true` and l10n.yaml uses `synthetic-package: false`.
# Source of truth lives in lib/l10n/*.arb; the .dart outputs are reproducible.
lib/l10n/generated/
lib/generated/
lib/l10n/app_localizations.dart
lib/l10n/app_localizations_*.dart

# -----------------------------------------------------------------------------
# Android
# -----------------------------------------------------------------------------
android/.gradle/
android/.idea/
android/captures/
android/local.properties
android/app/release/
android/app/debug/
android/app/profile/
android/gradle/
!android/gradle/
!android/gradle/wrapper/
!android/gradle/wrapper/**
android/gradlew
android/gradlew.bat
android/build/
android/app/build/
android/.cxx/
android/app/.cxx/
android/**/GeneratedPluginRegistrant.java
*.iml
*.ipr
*.iws

# APK / AAB / mapping outputs
*.apk
*.aab
*.dex
*.ap_
mapping.txt

